{
  "name": "@mvd/tsmd",
  "version": "1.0.3",
  "private": false,
  "description": "Generate markdown documentation from typescript source files",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "release": "pnpm run build && changeset version && changeset publish"
  },
  "dependencies": {
    "@structured-types/api": "^3.46.12",
    "yargs": "^17.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^26.0.0",
    "@types/yargs": "^17.0.20",
    "vite-plus": "catalog:"
  },
  "bin": "./index.js",
  "docs": "docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/tsmd.git"
  },
  "homepage": "https://meesvandongen.github.io/tsmd",
  "bugs": {
    "url": "https://github.com/meesvandongen/tsmd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
