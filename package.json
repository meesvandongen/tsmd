{
  "name": "@mvd/tsmd",
  "version": "1.0.3",
  "private": false,
  "description": "Generate markdown documentation from typescript source files",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "release": "pnpm run build && changeset version && changeset publish"
  },
  "dependencies": {
    "@structured-types/api": "^3.46.12",
    "yargs": "^17.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^18.11.18",
    "@types/yargs": "^17.0.20",
    "vite-plus": "catalog:"
  },
  "bin": "./index.js",
  "docs": "docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/tsmd.git"
  },
  "homepage": "https://meesvandongen.github.io/tsmd",
  "bugs": {
    "url": "https://github.com/meesvandongen/tsmd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
