{
  "name": "@mvd/tsmd",
  "version": "1.0.3",
  "private": false,
  "description": "Generate markdown documentation from typescript source files",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "release": "pnpm run build && changeset version && changeset publish"
  },
  "dependencies": {
    "@structured-types/api": "^3.46.12",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^18.11.18",
    "@types/yargs": "^17.0.20",
    "vite-plus": "catalog:"
  },
  "bin": "./index.js",
  "docs": "docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/tsmd.git"
  },
  "homepage": "https://meesvandongen.github.io/tsmd",
  "bugs": {
    "url": "https://github.com/meesvandongen/tsmd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
